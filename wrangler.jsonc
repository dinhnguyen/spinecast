{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spinecast",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/opds/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "spinecast", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "spinecast-books" }],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "REPLACE_WITH_KV_ID" }],
  "vars": { "MAX_UPLOAD_BYTES": "104857600", "SESSION_TTL_SECONDS": "2592000" },
  "observability": { "enabled": true }
}
